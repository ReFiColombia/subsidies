# Database (PostgreSQL — used by Prisma schema)
POSTGRES_URL="postgresql://user:password@localhost:5432/subsidies"

# Server
PORT=3001

# Dune Analytics
DUNE_API_KEY=""

# Admin access to beneficiary records (see src/auth.ts)
# The contract owner is always an admin. Add more wallets here, comma separated.
ADMIN_ADDRESSES=""
# Contract whose owner is the admin. Defaults to the V1 SubsidyProgram.
SUBSIDY_CONTRACT_ADDRESS=""
CELO_RPC_URL=""
# Extra browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=""

# Seed data for `npm run seed` (optional)
BENEFICIARIES_DATA=""
